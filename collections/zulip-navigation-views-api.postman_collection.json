        {
          "id": "c7c4daea-bb83-41ba-9e51-fecaa9cd5b9a",
          "name": "Add a navigation view",
          "request": {
            "name": "Add a navigation view",
            "description": {
              "content": "Adds a new custom left sidebar navigation view configuration\nfor the current user.\n\nThis can be used both to configure built-in navigation views,\nor to add new navigation views.\n\n**Changes**: New in Zulip 11.0 (feature level 390).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "navigation_views"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": {
                    "content": "",
                    "type": "text/plain"
                  },
                  "type": "any",
                  "value": "{{subdomain}}",
                  "key": "subdomain"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "fragment",
                  "value": "<string>",
                  "description": "(Required) A unique identifier for the view, used to determine navigation\nbehavior when clicked.\n\nClients should use this value to navigate to the corresponding URL hash.\n"
                },
                {
                  "disabled": false,
                  "key": "is_pinned",
                  "value": "<boolean>",
                  "description": "(Required) Determines whether the view appears directly in the sidebar or\nis hidden in the \"More Views\" menu.\n\n- `true` - Pinned and visible in the sidebar.\n- `false` - Hidden and accessible via the \"More Views\" menu.\n"
                },
                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "The user-facing name for custom navigation views. Omit this\nfield for built-in views.\n"
                }
              ]
            }
          },
