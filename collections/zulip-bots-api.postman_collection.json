          "id": "f260c51d-c313-469f-8612-8350e139f989",
          "name": "Update a bot's stored data",
          "request": {
            "name": "Update a bot's stored data",
            "description": {
              "content": "!!! warn \"\"\n\n    **Note:** This endpoint is only available to [bot user](/help/bots-overview)\n    accounts.\n\nAdd or update [data stored](/help/interactive-bots-api#bot_handlerstorage)\nfor a bot user.\n\nEach bot has a limited storage set by the server, which normally is a\ndefault of 10,000,000 characters.\n\n**Changes**: Prior to Zulip 12.0 (feature level 494), users who\nwere not bots could access this endpoint.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "bot_storage"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": {
                    "content": "",
                    "type": "text/plain"
                  },
                  "type": "any",
                  "value": "{{subdomain}}",
                  "key": "subdomain"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "key_0",
                  "value": "<string>",
                  "description": "(Required) A JSON-encoded dictionary mapping string keys to string values\nthat will be added to the bot's storage.\n\nIf the bot's storage already has a specific key, then the value\nstored for that key will be updated for the new value.\n"
                }
              ]
            }
          },
          "response": [
            {
              "id": "19d9cd19-3489-4c91-ad37-5b1c528fa878",
              "name": "Success.",
              "originalRequest": {
